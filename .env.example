# Copy ke .env (gitignored). Ganti <...> dengan nilai lokal, jangan commit .env.
# Local development only; replace this example password for any non-local use.
POSTGRES_USER=immerse
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=immerse
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgres://immerse:dev-only-change-me@127.0.0.1:5432/immerse?sslmode=disable
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
SESSION_DAYS=30
# Opsional: origin kanonik untuk check Origin/Referer pada POST.
# Set saat akses via https://immerse.app; kosong berarti Host request.
APP_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/auth/google/callback
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://127.0.0.1:3000
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
