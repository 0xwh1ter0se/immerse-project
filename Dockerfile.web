# Multi-stage Dockerfile for @immerse/web
FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.28.1 --activate

FROM base AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat

# Copy repo configuration files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source files
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

# Build shared package then web
RUN pnpm --filter @immerse/shared build
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN pnpm --filter @immerse/web build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy built application and required node_modules
COPY --from=builder /app ./

USER nextjs

EXPOSE 3000

CMD ["pnpm", "--filter", "@immerse/web", "start"]
