    "bullmq": "^6.7.7",
    "express": "5.3.0",
    "ioredis": "5.8.2",
    "jose": "6.1.2",
    "libphonenumber-js": "1.12.24",
    "midtrans-client": "1.4.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/midtrans-client": "1.4.0",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
